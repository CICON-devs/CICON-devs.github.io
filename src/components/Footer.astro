---
const instagram = "https://www.instagram.com/ciconhack/";
const linkedin = "https://www.linkedin.com/company/cicon-app/";
import { Icon } from 'astro-icon/components';
---
<footer class="footer">
    <div class="container footer-grid">
        <div class="footer-links-block">
            <h3 class="footer-title">Find Us</h3>
            <div class="footer-links">
                <a href={instagram} target="_blank" class="footer-link">
                    <Icon name="simple-icons:instagram" /> @ciconhack
                </a>
                <a href="https://discord.gg/kcQWbdr4fQ" target="_blank" class="footer-link">
                    <Icon name="simple-icons:discord" /> discord
                </a>
                <a href={linkedin} target="_blank" class="footer-link">
                    <Icon name="simple-icons:linkedin" /> cicon-app
                </a>
            </div>
        </div>
        <div class="footer-contact-block">
            <h3 class="footer-title">Contact Us</h3>
            <a href="mailto:salman.cicon@gmail.com" class="footer-link">salman.cicon@gmail.com</a>
        </div>
    </div>
    <!-- Footer bottom row -->
    <div class="container footer-bottom">
        <p>&copy; 2025 CICON. All rights reserved.</p>
    </div>
</footer>