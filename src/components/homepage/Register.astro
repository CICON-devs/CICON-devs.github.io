---
import { REGISTRATION_CLOSES_AT_ISO } from "../../config";
const googleFormUrl = "https://docs.google.com/forms/d/e/1FAIpQLSd1wNVrUiAOxbbMd0-Vl90ZmRzoweiBjVypZwi3tDtc_9Thtg/viewform";
---

<!-- Registration Section -->
<section id="register" class="register-section" data-reg-close={REGISTRATION_CLOSES_AT_ISO}>
    <div class="container">
        <div class="register-content">
            <h2 id="register-heading">Registrations are now closed!</h2>
            <div class="register-form" id="register-cta">
                <a class="btn-primary is-disabled" aria-disabled="true" style="margin-right: 0.5rem;">Registration Closed</a>
                <a href="https://docs.google.com/forms/d/e/1FAIpQLSeAhFrqotC0enpMphOL2Cq6rKvQL8Pu6ZUJ2mj_L9JW8SjWeg/viewform?usp=header" target="_blank" rel="noopener noreferrer" class="btn-secondary">Submit Now</a>
            </div>
            <p class="register-note" id="register-note">
                Submissions are now open. See the <a href="/submission-guidelines">submission guidelines</a> or submit directly via the form.
            </p>
            <div class="faq-callout-inside-register">
                <h3 class="faq-callout-title">Got Questions?</h3>
                <p class="faq-callout-text">Check out our FAQ for everything you need to know about our event</p>
                <a href="/faq" class="btn-secondary faq-callout-btn">Go to FAQ</a>
            </div>
        </div>
    </div>
</section>

<script is:inline>{``}</script>