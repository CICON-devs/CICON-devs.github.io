---
const googleFormUrl = "https://docs.google.com/forms/d/e/1FAIpQLSd1wNVrUiAOxbbMd0-Vl90ZmRzoweiBjVypZwi3tDtc_9Thtg/viewform";
---

<!-- Registration Section -->
<section id="register" class="register-section">
    <div class="container">
        <div class="register-content">
            <h2>Want to join? Register now!</h2>
            <div class="register-form">
                <a href={googleFormUrl} target="_blank" rel="noopener noreferrer" class="btn-primary">Register Now</a>
            </div>
            <p class="register-note">
                Registration deadline: <br/>
                <b>23:59 GMT+7 on August 17, 2025</b>
            </p>
            <div class="faq-callout-inside-register">
                <h3 class="faq-callout-title">Got Questions?</h3>
                <p class="faq-callout-text">Check out our FAQ for everything you need to know about CICON Hack 2025.</p>
                <a href="/faq" class="btn-secondary faq-callout-btn">Go to FAQ</a>
            </div>
        </div>
    </div>
</section>