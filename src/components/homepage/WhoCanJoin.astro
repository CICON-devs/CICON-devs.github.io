---
import { Icon } from 'astro-icon/components';
---

<!-- Who Can Join Section -->
<section id="who-can-join" class="who-can-join-section">
    <div class="container">
        <h2 class="section-title">Who Can Join?</h2>
        <p class="section-description">CICON Hack 2025 is open to everyone who wants to make repair better</p>
        
        <div class="requirements-grid">
            <div class="requirement-item">
                <div class="requirement-icon"><Icon name="lucide:users-round" /></div>
                <h3>Open to All</h3>
                <p>No age limits or restrictions. University students, fresh grads, professionals, and enthusiasts are all welcome!</p>
            </div>
            
            <div class="requirement-item">
                <div class="requirement-icon"><Icon name="lucide:handshake" /></div>
                <h3>Team or Solo</h3>
                <p>Join with up to 3 others (max 4 people total) or come solo, if you're interested in joining a team we'll help match you with a team.</p>
            </div>
            
            <div class="requirement-item">
                <div class="requirement-icon"><Icon name="lucide:lightbulb" /></div>
                <h3>No Skills Required</h3>
                <p>Come as you are! Whether you code, design, write, or just have ideas; we need all kinds of thinkers to build better repair.</p>
            </div>
            
            <div class="requirement-item">
                <div class="requirement-icon"><Icon name="lucide:languages" /></div>
                <h3>English Proficiency</h3>
                <p>You'll need to present and communicate in English during the hackathon and final pitch.</p>
            </div>
        </div>
        
        <div class="requirements-note">
            <p>Not sure if you qualify? <a href="/faq" class="requirements-link">Check our FAQ</a> or just reach out, we're here to help!</p>
        </div>
    </div>
</section> 