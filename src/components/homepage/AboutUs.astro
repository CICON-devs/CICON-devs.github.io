<!-- About CICON Section -->
<section id="about-cicon" class="about-cicon-section">
  <div class="container about-cicon-container">
    <div class="about-cicon-image-wrapper">
      <img
        src="/images/colored-radial-cobbler.jpg"
        alt="About CICON"
        class="about-cicon-image"
      />
      <div class="about-cicon-overlay"></div>
    </div>
    <div class="about-cicon-content">
      <h2 class="section-title" style="text-align: left;">About CICON</h2>
      <p class="section-description" style="text-align: left;">
        CICON, which stands for <b>Circular Concierge</b>, is a platform for
        circular repair, helping people fix, not throw. Our mission is to make
        repair easy, visible, and scalable, starting with shoe repair across the
        UK.
      </p>
      <p class="about-cicon-body">
        This hackathon is one part of that effort, a space to explore ideas,
        tools, and content that could shape how people engage with repair.
        Whether you're a designer, coder, or storyteller, your work could
        influence our platform we're already building at
        <a
          href="https://cicon.vercel.app"
          class="about-cicon-link"
          target="_blank"
          rel="noopener"
          >CICON</a
        >.
      </p>
    </div>
  </div>
</section>
