<!-- Timeline Section -->
<section id="timeline" class="timeline-section">
    <div class="container">
        <h2 class="section-title">Hackathon Timeline</h2>
        <p class="section-description">
            Here's how the hackathon unfolds
        </p>
        <div class="timeline">
            <div class="timeline-item">
                <div class="timeline-date">July 29 - August 17</div>
                <div class="timeline-content">
                    <h3>Registrations Open</h3>
                    <p>Open registration for everyone, participants who want to join a team can register and we'll help them find a team</p>
                </div>
            </div>

            <div class="timeline-item">
                <div class="timeline-date">August 17 - 22</div>
                <div class="timeline-content">
                    <h3>Idea Submission</h3>
                    <p>Teams submit their ideas for the hackathon. Perfect time for teams to discuss and finalize their idea</p>
                </div>
            </div>
            
            
            <div class="timeline-item">
                <div class="timeline-date">August 23 - 25</div>
                <div class="timeline-content">
                    <h3>Review & Shortlisting</h3>
                    <p>Internal team selects the <b>top 10 teams</b> for the live hackathon</p>
                </div>
            </div>

            
            <div class="timeline-item">
                <div class="timeline-date">August 26</div>
                <div class="timeline-content">
                    <h3>Finalist Announcement</h3>
                    <p>Selected teams announced with preparation materials and mentor assignments</p>
                </div>
            </div>
            
            <div class="timeline-item">
                <div class="timeline-date">September 1 - 5</div>
                <div class="timeline-content">
                    <h3>Mentor Check-in</h3>
                    <p>One-on-one mentor sessions to help finalists refine scope and prepare</p>
                </div>
            </div>
            
            <div class="timeline-item highlight">
                <div class="timeline-date">September 6</div>
                <div class="timeline-content">
                    <h3>Live Hackathon Day</h3>
                    <p>Hackathon (9 AM - 6 PM GMT+7) with mentor sessions and checkpoints, fully online</p>
                </div>
            </div>
            
            <div class="timeline-item">
                <div class="timeline-date">September 7</div>
                <div class="timeline-content">
                    <h3>Pitching & Winner Announcement</h3>
                    <p>Live pitch presentations, Q&A sessions, and winner announcement!</p>
                </div>
            </div>
        </div>
    </div>
</section>