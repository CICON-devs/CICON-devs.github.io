<!-- Timeline Section -->
<section id="timeline" class="timeline-section">
    <div class="container">
        <h2 class="section-title">Hackathon Timeline</h2>
        <p class="section-description">
            Here's how the hackathon unfolds
        </p>
        <div class="timeline">
            <div class="timeline-item">
                <div class="timeline-date">July 29 - August 17</div>
                <div class="timeline-content">
                    <h3>Registrations</h3>
                    <p>Registration window for all participants. Team formation support available during this period.</p>
                </div>
            </div>

            <div class="timeline-item">
                <div class="timeline-date">August 18 - 29</div>
                <div class="timeline-content">
                    <h3>Submissions Open</h3>
                    <p>Teams submit their ideas for the hackathon. Perfect time to discuss and finalize the concept.</p>
                </div>
            </div>
            
            
            <div class="timeline-item">
                <div class="timeline-date">August 30 - 31</div>
                <div class="timeline-content">
                    <h3>Review & Shortlisting</h3>
                    <p>Internal review to select the <b>top 10 teams</b> for the live hackathon.</p>
                </div>
            </div>

            
            <div class="timeline-item">
                <div class="timeline-date">September 1</div>
                <div class="timeline-content">
                    <h3>Finalist Announcement</h3>
                    <p>Selected teams announced with preparation materials and mentor assignments.</p>
                </div>
            </div>
            
            <div class="timeline-item">
                <div class="timeline-date">September 1 - 5</div>
                <div class="timeline-content">
                    <h3>Mentor Check-in</h3>
                    <p>One-on-one mentor sessions to help finalists refine scope and prepare</p>
                </div>
            </div>
            
            <div class="timeline-item">
                <div class="timeline-date">September 6</div>
                <div class="timeline-content">
                    <h3>Catch-up & Prep Day</h3>
                    <p>Optional catch-up and preparation sessions for finalists with mentors ahead of pitch day.</p>
                </div>
            </div>
            
            <div class="timeline-item highlight">
                <div class="timeline-date">September 7</div>
                <div class="timeline-content">
                    <h3>Pitching & Winner Announcement</h3>
                    <p>Pitching from <b>16:00 — 19:00 GMT+7</b> (<b>10:00 — 13:00 BST</b>). End time may change; start time fixed. Winner announcement to follow.</p>
                </div>
            </div>
        </div>
    </div>
</section>