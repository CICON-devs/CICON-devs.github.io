---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Team - CICON Hack 2025';
const description = 'Meet the team behind CICON Hack 2025 - passionate individuals dedicated to building the future of repair.';
---

<BaseLayout {title} {description}>
	<main>
		<!-- Hero Section -->
		<section class="hero">
			<div class="container">
				<div class="hero-content">
					<div class="hero-badge">
						<span>Meet the Team</span>
					</div>
					<h1 class="hero-title">
						The People Behind CICON
					</h1>
					<p class="hero-description">
						We're a passionate team of innovators, developers, and repair enthusiasts working to build 
						sustainable solutions for the future. Get to know the people making CICON Hack 2025 possible.
					</p>
				</div>
			</div>
		</section>

		<!-- Team Section -->
		<section class="team-section">
			<div class="container">
				<h2 class="section-title">Our Team</h2>
				<p class="section-description">Meet the passionate individuals driving innovation in the repair ecosystem</p>
				
				<div class="team-grid">
					<div class="team-card">
						<div class="team-photo">
							<div class="photo-placeholder">
								<span>👩‍🏫</span>
							</div>
						</div>
						<div class="team-info">
							<h3>Tanya</h3>
							<p class="team-role">Founder & CEO</p>
							<p class="team-bio">Passionate about sustainable technology and community-driven repair solutions.</p>
						</div>
					</div>

					<div class="team-card">
						<div class="team-photo">
							<div class="photo-placeholder">
								<span>👩‍💼</span>
							</div>
						</div>
						<div class="team-info">
							<h3>Alek</h3>
							<p class="team-role">Head of Operations</p>
							<p class="team-bio">Expert in logistics and supply chain optimization. Dedicated to making repair services accessible to everyone.</p>
						</div>
					</div>

					<div class="team-card">
						<div class="team-photo">
							<div class="photo-placeholder">
								<span>👨‍🔧</span>
							</div>
						</div>
						<div class="team-info">
							<h3>Salman</h3>
							<p class="team-role">Lead Developer</p>
							<p class="team-bio">Full-stack developer with expertise in scalable platforms. Building the technical foundation for CICON's growth.</p>
						</div>
					</div>
				</div>
			</div>
		</section>
	</main>
</BaseLayout>