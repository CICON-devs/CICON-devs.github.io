		<style>
			* {
				margin: 0;
				padding: 0;
				box-sizing: border-box;
			}

			body {
				font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
				line-height: 1.6;
				color: #1a1a1a;
				background: #ffffff;
			}

			.container {
				max-width: 1200px;
				margin: 0 auto;
				padding: 0 2rem;
			}

			/* Navigation */
			.nav {
				position: fixed;
				top: 0;
				left: 0;
				right: 0;
				background: rgba(255, 255, 255, 0.95);
				backdrop-filter: blur(10px);
				border-bottom: 1px solid #e5e5e5;
				z-index: 1000;
			}

			.nav-container {
				max-width: 1200px;
				margin: 0 auto;
				padding: 1rem 2rem;
				display: flex;
				align-items: center;
				justify-content: space-between;
			}

			.nav-brand {
				display: flex;
				align-items: center;
				gap: 0.75rem;
			}

			.logo {
				height: 32px;
				width: auto;
			}

			.nav-title {
				font-weight: 600;
				font-size: 1.1rem;
			}

			.nav-links {
				display: flex;
				align-items: center;
				gap: 2rem;
			}

			.nav-links a {
				text-decoration: none;
				color: #666;
				font-weight: 500;
				transition: color 0.2s;
			}

			.nav-links a:hover {
				color: #197F59;
			}

			/* Buttons */
			.btn-primary {
				background: #197F59;
				color: white !important;
				padding: 0.75rem 1.5rem;
				border-radius: 8px;
				text-decoration: none;
				font-weight: 500;
				transition: all 0.2s;
				border: none;
				cursor: pointer;
				display: inline-flex;
				align-items: center;
				justify-content: center;
			}

			.btn-primary:hover {
				background: #0D402D;
				transform: translateY(-1px);
			}

			.btn-secondary {
				background: transparent;
				color: #197F59;
				padding: 0.75rem 1.5rem;
				border: 2px solid #197F59;
				border-radius: 8px;
				text-decoration: none;
				font-weight: 500;
				transition: all 0.2s;
			}

			.btn-secondary:hover {
				background: #197F59;
				color: white;
			}

			/* Hero Section */
			.hero {
				padding: 8rem 0 6rem;
				background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);
			}

			.hero-content {
				text-align: center;
				max-width: 800px;
				margin: 0 auto;
			}

			.hero-badge {
				display: inline-block;
				background: #d1fae5;
				color: #197F59;
				padding: 0.5rem 1rem;
				border-radius: 50px;
				font-size: 0.9rem;
				font-weight: 500;
				margin-bottom: 2rem;
			}

			.hero-title {
				font-size: 3.5rem;
				font-weight: 700;
				margin-bottom: 1.5rem;
				line-height: 1.1;
			}

			.gradient-text {
				background: linear-gradient(135deg, #197F59, #0D402D);
				-webkit-background-clip: text;
				-webkit-text-fill-color: transparent;
				background-clip: text;
			}

			.hero-description {
				font-size: 1.25rem;
				color: #64748b;
				margin-bottom: 3rem;
				line-height: 1.6;
			}

			/* Section Styles */
			.section-title {
				font-size: 2.5rem;
				font-weight: 700;
				text-align: center;
				margin-bottom: 1rem;
			}

			.section-description {
				font-size: 1.2rem;
				color: #64748b;
				text-align: center;
				margin-bottom: 4rem;
			}

			/* Team Section */
			.team-section {
				padding: 6rem 0;
				background: white;
			}

			.team-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
				gap: 2rem;
			}

			.team-card {
				background: #f8fafc;
				padding: 2rem;
				border-radius: 16px;
				border: 1px solid #e5e5e5;
				transition: all 0.3s;
				text-align: center;
			}

			.team-card:hover {
				transform: translateY(-5px);
				box-shadow: 0 10px 40px rgba(0, 0, 0, 0.1);
				border-color: #197F59;
			}

			.team-photo {
				margin-bottom: 1.5rem;
			}

			.photo-placeholder {
				width: 120px;
				height: 120px;
				background: linear-gradient(135deg, #197F59, #0D402D);
				border-radius: 50%;
				display: flex;
				align-items: center;
				justify-content: center;
				margin: 0 auto;
				font-size: 3rem;
			}

			.team-info h3 {
				font-size: 1.5rem;
				font-weight: 600;
				margin-bottom: 0.5rem;
			}

			.team-role {
				color: #197F59;
				font-weight: 500;
				margin-bottom: 1rem;
			}

			.team-bio {
				color: #64748b;
				margin-bottom: 1.5rem;
				line-height: 1.6;
			}

			.team-links {
				display: flex;
				justify-content: center;
				gap: 1rem;
			}

			.team-link {
				color: #197F59;
				text-decoration: none;
				font-weight: 500;
				padding: 0.5rem 1rem;
				border-radius: 6px;
				background: #d1fae5;
				transition: all 0.2s;
			}

			.team-link:hover {
				background: #197F59;
				color: white;
			}

			/* Values Section */
			.values-section {
				padding: 6rem 0;
				background: #f8fafc;
			}

			.values-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
				gap: 2rem;
			}

			.value-card {
				background: white;
				padding: 2.5rem 2rem;
				border-radius: 16px;
				border: 1px solid #e5e5e5;
				text-align: center;
				transition: all 0.3s;
			}

			.value-card:hover {
				transform: translateY(-5px);
				box-shadow: 0 10px 40px rgba(0, 0, 0, 0.1);
				border-color: #197F59;
			}

			.value-icon {
				font-size: 3rem;
				margin-bottom: 1.5rem;
			}

			.value-card h3 {
				font-size: 1.5rem;
				font-weight: 600;
				margin-bottom: 1rem;
			}

			.value-card p {
				color: #64748b;
				line-height: 1.6;
			}

			/* Join Section */
			.join-section {
				padding: 6rem 0;
				background: linear-gradient(135deg, #197F59, #0D402D);
				color: white;
				text-align: center;
			}

			.join-content h2 {
				font-size: 2.5rem;
				font-weight: 700;
				margin-bottom: 1rem;
			}

			.join-content p {
				font-size: 1.2rem;
				margin-bottom: 3rem;
				opacity: 0.9;
			}

			.join-actions {
				display: flex;
				gap: 1rem;
				justify-content: center;
			}

			.join-section .btn-secondary {
				border-color: white;
				color: white;
			}

			.join-section .btn-secondary:hover {
				background: white;
				color: #197F59;
			}

			/* Footer */
			.footer {
				background: #1a1a1a;
				color: white;
				padding: 4rem 0 2rem;
			}

			.footer-content {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
				gap: 3rem;
				margin-bottom: 3rem;
			}

			.footer-brand img {
				height: 40px;
				margin-bottom: 1rem;
			}

			.footer-brand p {
				color: #a1a1aa;
				line-height: 1.6;
			}

			.footer-links h4,
			.footer-contact h4 {
				font-weight: 600;
				margin-bottom: 1rem;
			}

			.footer-links a {
				display: block;
				color: #a1a1aa;
				text-decoration: none;
				margin-bottom: 0.5rem;
				transition: color 0.2s;
			}

			.footer-links a:hover {
				color: white;
			}

			.footer-contact p {
				color: #a1a1aa;
				margin-bottom: 0.5rem;
			}

			.footer-bottom {
				border-top: 1px solid #374151;
				padding-top: 2rem;
				text-align: center;
				color: #a1a1aa;
			}

			/* Responsive Design */
			@media (max-width: 768px) {
				.nav-links {
					display: none;
				}

				.hero-title {
					font-size: 2.5rem;
				}

				.team-grid,
				.values-grid {
					grid-template-columns: 1fr;
				}

				.join-actions {
					flex-direction: column;
					align-items: center;
				}

				.footer-content {
					grid-template-columns: 1fr;
					text-align: center;
				}
			}

			/* Smooth scrolling */
			html {
				scroll-behavior: smooth;
			}

			/* Focus styles for accessibility */
			a:focus,
			button:focus {
				outline: 2px solid #197F59;
				outline-offset: 2px;
			}
		</style>
	</body>
</html> 