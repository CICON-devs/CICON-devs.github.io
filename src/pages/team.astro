---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Team - CICON Hack 2025';
const description = 'Meet the team behind CICON Hack 2025 - passionate individuals dedicated to building the future of repair.';
---

<BaseLayout {title} {description}>
	<main>
		<!-- Hero Section -->
		<section class="hero">
			<div class="container">
				<div class="hero-content">
					<div class="hero-title-container">
						<h1 class="hero-title">
							The People Behind CICON
						</h1>
					</div>
					<p class="hero-description">
						CICON stands for <b>Circular Concierge</b>, our vision for a world where repair is simple, accessible, and worth choosing.</p>
				</div>
			</div>
		</section>

		<!-- Team Section -->
		<section class="team-section">
			<div class="container">
				<h2 class="section-title">Our Team</h2>
				<p class="section-description">A small team with a big mission: meet the people building CICON from the ground up</p>
				
				<div class="team-grid">
					<div class="team-card">
						<div class="team-photo">
							<div class="photo-placeholder">
								<span>👩‍🏫</span>
							</div>
						</div>
						<div class="team-info">
							<h3>Tanya</h3>
							<p class="team-role">Founder & CEO</p>
						</div>
					</div>

					<div class="team-card">
						<div class="team-photo">
							<div class="photo-placeholder">
								<span>👩‍💼</span>
							</div>
						</div>
						<div class="team-info">
							<h3>Alek</h3>
							<p class="team-role">Project Manager</p>
						</div>
					</div>

					<div class="team-card">
						<div class="team-photo">
							<div class="photo-placeholder">
								<span>👨‍🔧</span>
							</div>
						</div>
						<div class="team-info">
							<h3>Salman</h3>
							<p class="team-role">Lead Developer</p>
						</div>
					</div>
				</div>
			</div>
		</section>
	</main>
</BaseLayout>