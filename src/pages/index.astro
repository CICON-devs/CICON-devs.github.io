---
import BaseLayout from "../layouts/BaseLayout.astro";

import Timeline from "../components/homepage/Timeline.astro";
import Prizes from "../components/homepage/Prizes.astro";
import ChallengeThemes from "../components/homepage/ChallengeThemes.astro";
import AboutUs from "../components/homepage/AboutUs.astro";
import Register from "../components/homepage/Register.astro";
import WhoCanJoin from "../components/homepage/WhoCanJoin.astro";
import { REGISTRATION_CLOSES_AT_ISO, SUBMISSION_CLOSES_AT_ISO } from "../config";

const title = "CICON Hack 2025";
const description =
  "Join CICON Hack 2025, an online hackathon focused on building innovative solutions for the repair ecosystem.";
---

<BaseLayout {title} {description}>
  <main>
    <!-- Hero Section -->
    <section class="hero" data-reg-close={REGISTRATION_CLOSES_AT_ISO} data-sub-close={SUBMISSION_CLOSES_AT_ISO} data-submit-url="https://docs.google.com/forms/d/e/1FAIpQLSeAhFrqotC0enpMphOL2Cq6rKvQL8Pu6ZUJ2mj_L9JW8SjWeg/viewform?usp=header">
      <div class="container">
        <div class="hero-content">
          <div class="hero-title-container">
            <h1 class="hero-title">CICON Hack 2025</h1>
          </div>
          <div class="hero-badge">
            <span>September 6, 2025 • 9 AM — 6 PM GMT+7</span>
          </div>
          <div class="countdown-wrapper">
            <p class="countdown-label" id="countdown-label">Submissions close 25 Aug 2025:</p>
            <div id="countdown" class="countdown" aria-label="Countdown to registration deadline">
              <span><span id="countdown-days">00</span>d</span>
              <span><span id="countdown-hours">00</span>h</span>
              <span><span id="countdown-minutes">00</span>m</span>
              <span><span id="countdown-seconds">00</span>s</span>
            </div>
          </div>
          <p class="hero-description">
            Every repaired shoe is one less in the landfill. Join our hackathon to make repair accessible and move sustainability forward.
          </p>
          <div class="stat">
            <div class="stat-content">
              <div class="stat-number">Rp 5.000.000</div>
              <div class="stat-label">in prizes and more!</div>
            </div>
          </div>
          <div class="hero-actions">
            <a href="#register" class="btn-primary btn-large hero-btn" id="hero-register-btn">
              Register for Free
            </a>
            <a href="#timeline" class="btn-secondary btn-large hero-btn">
              View Timeline
            </a>
          </div>
        </div>
      </div>
    </section>

    <script is:inline>
      (function () {
        const hero = document.querySelector('.hero');
        const regIso = hero?.getAttribute('data-reg-close');
        const subIso = hero?.getAttribute('data-sub-close');
        const submitUrl = hero?.getAttribute('data-submit-url');
        if (!regIso || !subIso) return;
        const registrationClose = new Date(regIso);
        const submissionClose = new Date(subIso);
        let targetDate = registrationClose; // default to registration countdown
        function pad(n) {
          return n.toString().padStart(2, "0");
        }
        function updateCountdown() {
          const now = new Date();
          // After registration closes, switch countdown to submission deadline
          targetDate = now >= registrationClose ? submissionClose : registrationClose;
          let diff = targetDate - now;
          if (diff < 0) diff = 0;
          const days = Math.floor(diff / (1000 * 60 * 60 * 24));
          const hours = Math.floor((diff / (1000 * 60 * 60)) % 24);
          const minutes = Math.floor((diff / (1000 * 60)) % 60);
          const seconds = Math.floor((diff / 1000) % 60);

          document.getElementById("countdown-days").textContent = pad(days);
          document.getElementById("countdown-hours").textContent = pad(hours);
          document.getElementById("countdown-minutes").textContent = pad(minutes);
          document.getElementById("countdown-seconds").textContent = pad(seconds);
        }
        updateCountdown();
        setInterval(updateCountdown, 1000);

        // If closed, hide countdown and disable hero CTA
        const nowForCta = new Date();
        const registrationIsClosed = nowForCta >= registrationClose;
        if (registrationIsClosed) {
          const label = document.getElementById('countdown-label');
          if (label) label.textContent = 'Submissions close 25 Aug 2025:';
          const heroBtn = document.getElementById('hero-register-btn');
          if (heroBtn) {
            if (submitUrl) {
              heroBtn.classList.remove('is-disabled');
              heroBtn.removeAttribute('aria-disabled');
              heroBtn.setAttribute('href', submitUrl);
              heroBtn.setAttribute('target', '_blank');
              heroBtn.setAttribute('rel', 'noopener noreferrer');
              heroBtn.textContent = 'Submit Now';
            } else {
              heroBtn.classList.add('is-disabled');
              heroBtn.setAttribute('aria-disabled', 'true');
              heroBtn.textContent = 'Registration Closed';
              heroBtn.addEventListener('click', function (e) { e.preventDefault(); });
            }
          }
        }
      })();
    </script>

    <WhoCanJoin />
    <ChallengeThemes />
    <Timeline />

    <Prizes />
    <AboutUs />
    <Register />
  </main>
</BaseLayout>
